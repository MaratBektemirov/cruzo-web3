{
  "name": "cruzo-web3",
  "version": "0.3.2",
  "description": "Web3 addon for cruzo: wallet providers, sign, verify",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.module.css",
    "lib/**/*.component.ts"
  ],
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    },
    "./components/web3-signing": {
      "types": "./lib/components/web3-signing/web3-signing.component.ts",
      "default": "./lib/components/web3-signing/web3-signing.component.ts"
    },
    "./components/web3-signer": {
      "types": "./lib/components/web3-signer/web3-signer.component.ts",
      "default": "./lib/components/web3-signer/web3-signer.component.ts"
    },
    "./components/secret-auth": {
      "types": "./lib/components/secret-auth/secret-auth.component.ts",
      "default": "./lib/components/secret-auth/secret-auth.component.ts"
    },
    "./secret-auth": {
      "types": "./lib/secret-auth/index.ts",
      "default": "./lib/secret-auth/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@tonconnect/sdk": "^3.4.1",
    "@tonconnect/ui": "^3.0.0",
    "@walletconnect/ethereum-provider": "^2.23.9"
  },
  "peerDependencies": {
    "cruzo": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "cruzo": "1.1.0",
    "typescript": "5.9.3"
  }
}
